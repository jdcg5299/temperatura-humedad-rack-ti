# Copia este archivo a /home/pi/rack.env en la Raspberry Pi y edita la IP.
# La IP real de la VM NO va en el repositorio (CONSTITUTION.md, principio 6).
# systemd lo carga con EnvironmentFile antes de arrancar enviar.py.

SERVIDOR_URL=http://IP_DE_LA_VM:5000/api/lecturas
DISPOSITIVO=rack-01
INTERVALO_SEGUNDOS=10
