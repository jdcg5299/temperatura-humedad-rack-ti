# Copia este archivo como servidor/.env y ajusta los valores.
# .env nunca va al repositorio (esta en .gitignore): la clave no es codigo.

# URL de PostgreSQL para el almacenamiento del servidor.
# Si se deja comentada o vacia, el servidor usa SQLite (datos.db) como siempre.
# Formato: postgresql://usuario:clave@host:puerto/nombre
DATABASE_URL=postgresql://rack:CAMBIA_ESTA_CLAVE@localhost:5432/rack
